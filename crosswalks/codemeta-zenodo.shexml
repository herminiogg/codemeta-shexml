PREFIX codemeta: <https://w3id.org/codemeta/3.0/>
PREFIX schema: <http://schema.org/>
PREFIX ex: <http://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SOURCE zenodo_record <https://zenodo.org/api/records/11577338>
FUNCTIONS helper <scala: https://raw.githubusercontent.com/herminiogg/codemeta-shexml/main/functions.scala>
ITERATOR info <jsonpath: $> {
    FIELD title <title>
    FIELD codeRepository <metadata.related_identifiers.isSupplementTo>
    FIELD applicationCategory <communities>
    FIELD downloadUrl <metadata.related_identifiers.isIdenticalTo>
    FIELD datePublished <metadata.publication_date>
    FIELD funder <metadata.contributors.funder>
    FIELD keywords <metadata.keywords>
    FIELD license <metadata.license.id>
    FIELD version <metadata.version>
    FIELD description <metadata.description>
    FIELD identifier <id>
    FIELD funding <metadata.grants.title>
    FIELD issueTracker <metadata.related_identifiers.isSupplementedBy>
    ITERATOR author <metadata.creators[*]> {
        FIELD name <name>
        FIELD affiliation <affiliation>
        FIELD identifier <orcid>
    }
}
EXPRESSION zm <zenodo_record.info>

schema:SoftwareSourceCode ex:[zm.title] {
    a schema:SoftwareSourceCode ;

    schema:codeRepository [zm.codeRepository] ;
    schema:applicationCategory [zm.applicationCategory] ;
    schema:downloadUrl [zm.downloadUrl] ;
    schema:datePublished [zm.datePublished] xsd:date ;
    schema:funder [zm.funder] ;
    schema:keywords [zm.keywords] ;
    schema:license [helper.licenseToURL(zm.license)] ;
    schema:version [zm.version] ;
    schema:description [zm.description] ;
    schema:identifier [zm.identifier] ;
    schema:name [zm.title] ;
    codemeta:funding [zm.funding] ;
    codemeta:issueTracker [zm.issueTracker] ;

    schema:author @schema:Person ;
}

schema:Person ex:[zm.author.name] {
    a schema:Person ;

    schema:name [zm.author.name] ;
    schema:affiliation @schema:Organization ;
    schema:identifier [zm.author.identifier] ;
}

schema:Organization ex:[zm.author.affiliation] {
    a schema:Organization ;
    schema:name [zm.author.affiliation] ;
}
