PREFIX codemeta: <https://w3id.org/codemeta/3.0/>
PREFIX schema: <http://schema.org/>
PREFIX ex: <http://example.org/>
SOURCE repo_info <https://repo1.maven.org/maven2/com/herminiogarcia/shexml_3/0.6.1/shexml_3-0.6.1.pom>
FUNCTIONS helper <scala: https://raw.githubusercontent.com/herminiogg/codemeta-shexml/main/functions.scala>
ITERATOR maven <xpath: /node()[local-name(.)='project']> {
    FIELD id <node()[local-name(.)='groupId']>
    FIELD name <node()[local-name(.)='name']>
    FIELD description <node()[local-name(.)='description']>
    FIELD codeRepository <node()[local-name(.)='scm']/node()[local-name(.)='url']>
    FIELD license <node()[local-name(.)='licenses']/node()[local-name(.)='license']/node()[local-name(.)='url']>
    FIELD version <node()[local-name(.)='version']>
    FIELD continuousIntegration <node()[local-name(.)='ciManagement']>
    FIELD issueTracker <node()[local-name(.)='issueManagement']>
    ITERATOR softwareRequirements <node()[local-name(.)='dependencies']/node()[local-name(.)='dependency']> {
        FIELD groupId <node()[local-name(.)='groupId']>
        FIELD artifactId <node()[local-name(.)='artifactId']>
        FIELD version <node()[local-name(.)='version']>
    }
}
EXPRESSION md <repo_info.maven>

schema:SoftwareSourceCode ex:[md.name] {
    a schema:SoftwareSourceCode ;
    schema:identifier [md.id] ;
    schema:name [md.name] ;
    schema:description [md.description] ;
    schema:codeRepository [md.codeRepository] ;
    schema:license [md.license] ;
    schema:version [md.version] ;
    codemeta:continuousIntegration [md.continuousIntegration] ;
    codemeta:issueTracker [md.issueTracker] ;
    schema:softwareRequirements @ex:Dependency ;
}

ex:Dependency ex:[md.softwareRequirements.artifactId] {
    a schema:SoftwareSourceCode ;
    schema:name [helper.concatenateMavenGroupAndArtifactIds(md.softwareRequirements.groupId, md.softwareRequirements.artifactId)] ;
    schema:version [md.softwareRequirements.version] ;
}
