            "@type": "@id"
        },
        "dateCreated": {
            "@id": "schema:dateCreated",
            "@type": "http://www.w3.org/2001/XMLSchema#date"
        },
        "softwareRequirements": {
            "@id": "schema:softwareRequirements",
            "@type": "@id"
        },
        "developmentStatus": {
            "@id": "schema:developmentStatus"
        },
